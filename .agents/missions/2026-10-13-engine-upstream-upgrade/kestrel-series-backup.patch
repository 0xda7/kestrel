+    for (size_t i = 0; i < comm_ctx->backends.size(); ++i) {
+        ggml_metal_t ctx = (ggml_metal_t) comm_ctx->backends[i]->context;
+        const uint64_t group = ggml_metal_peer_group_id(ctx);
+        if (group == 0) {
+            return false;
