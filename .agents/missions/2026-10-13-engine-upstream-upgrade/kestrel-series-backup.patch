+    float ss = 0.0f;
+    FOR_UNROLL (short v = 0; v < NV; v++) {
+        reg[v] = x[tiisg + NW*sgb + NT*v];
+    }
+    if (args.add) {
+        device const float * x1 = (device const float *) (src1 + tgpig.x*args.nb11) + blk*N;
+        device       float * xa = (device       float *) (dsta + tgpig.x*args.nb1a) + blk*N;
