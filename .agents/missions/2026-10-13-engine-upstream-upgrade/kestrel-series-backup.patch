+    device const int * pidx = nullptr;
+    if (has_sparse) {
+        pidx = idx +
+            ((int64_t)(iq3%args.ne33)*args.ne32 + (iq2%args.ne32))*args.ne31*args.n_kv_max_padded +
+            (iq1%args.ne31)*args.n_kv_max_padded;
