+        for (short i = sgitg; i < DV4; i += NSG) {
+            float4 v = 0.0f;
+            for (short r = 0; r < GPL; ++r) {
+                const short g = tiisg*GPL + r;
+                if (g < NG) {
+                    v += fr[r]*sh_acc[g*SAS + i];
