+// repeated uploads of stable host memory need no allocation or memcpy
+void * ggml_metal_device_wrap_host(ggml_metal_device_t dev, const void * data, size_t size, size_t * offs) {
+    if (size == 0 || data == NULL) {
+        return NULL;
+    }
