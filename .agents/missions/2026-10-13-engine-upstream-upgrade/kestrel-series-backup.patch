+        device const v_t * vb = (device const v_t *) (vp + (uint64_t) i11a*args.nb21);
+        for (short c = 0; c < NCV; ++c) {
+            const short ch = lch + c*SUBW;
+            if (ch < DV4) {
+                float4 vreg;
+                deq_v(vb + ch/NKV, ch%NKV, vreg);
