+// Direct copy between GPUs in the same Metal peer group.
+static bool ggml_metal_cpy_xdev_peer(ggml_metal_t ctx_src, ggml_metal_t ctx_dst,
+                                     const struct ggml_tensor * src, struct ggml_tensor * dst) {
