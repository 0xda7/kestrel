+            if (kestrel_mgpu_trace()) atomic_fetch_add(&g_tr_cmd_all, 1);
+            id<MTLCommandBuffer> cmd_src = [ctx_src->queue commandBuffer];
+            kestrel_trace_cmd_buf(cmd_src);
+            ggml_metal_encode_pending_waits(ctx_src, cmd_src);
