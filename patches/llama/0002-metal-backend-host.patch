+        const int64_t s1 = (int64_t) atomic_load(&g_gr[slot].start_ns[1]);
+        const int64_t e0 = (int64_t) atomic_load(&g_gr[slot].end_ns[0]);
+        const int64_t e1 = (int64_t) atomic_load(&g_gr[slot].end_ns[1]);
