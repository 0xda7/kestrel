+        atomic_fetch_add(&g_dur_n[side], 1);
+        atomic_fetch_add(&g_dur_sum[side], en - st);
+        atomic_fetch_add(&g_dur_h[side][kestrel_dur_bucket((en - st)/1000.0)], 1);
