+// KESTREL_MGPU_PEER_SELF runs the peer hand-off between two logical devices backed by the
+// same GPU (GGML_METAL_DEVICE_LIST=0,0), which needs no bridge: the queues are still
+// separate, so the cross-device ordering is testable on a single card.
+static bool ggml_metal_peer_self(void) {
+    static int val = -1;
+    if (val < 0) {
+        const char * v = KESTREL_ENV("KESTREL_MGPU_PEER_SELF");
+        val = (v && v[0] == '1') ? 1 : 0;
+    }
+    return val;
+}
