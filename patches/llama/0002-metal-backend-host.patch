+        fprintf(stderr, "KESTREL_CBP  readback: %llu lecturas, %.2f MiB, %.1f ms | subidas: %llu, %.2f MiB, %.1f ms\n",
+                (unsigned long long) dn,
+                atomic_load_explicit(&g_kestrel_d2h_bytes, memory_order_relaxed)/1048576.0,
+                atomic_load_explicit(&g_kestrel_d2h_ns,    memory_order_relaxed)/1e6,
+                (unsigned long long) hn,
+                atomic_load_explicit(&g_kestrel_h2d_bytes, memory_order_relaxed)/1048576.0,
+                atomic_load_explicit(&g_kestrel_h2d_ns,    memory_order_relaxed)/1e6);
