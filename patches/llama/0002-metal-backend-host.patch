+        ggml_tensor * clamp   = ctx->node(idx + 4);
+        ggml_tensor * div     = ctx->node(idx + 5);
+
+        if (sumrows->op != GGML_OP_SUM_ROWS || clamp->op != GGML_OP_CLAMP || div->op != GGML_OP_DIV ||
+            !ggml_metal_kestrel_topk_moe_same(sumrows->src[0], getrows) ||
+            !ggml_metal_kestrel_topk_moe_same(clamp->src[0], sumrows) ||
+            !ggml_metal_kestrel_topk_moe_same(div->src[0], getrows) ||
+            !ggml_metal_kestrel_topk_moe_same(div->src[1], clamp) ||
+            !ggml_is_contiguous(div) ||
