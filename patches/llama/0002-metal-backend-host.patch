+        /*.nrows           =*/ nrows,
+        /*.mode            =*/ plan.delayed ? 3 : 0,
+        /*.with_norm       =*/ plan.with_norm ? 1 : 0,
+        /*.delayed_softmax =*/ plan.delayed ? 1 : 0,
+        /*.has_bias        =*/ 0,
+        /*.clamp           =*/ plan.clamp,
+        /*.scale           =*/ 1.0f,
