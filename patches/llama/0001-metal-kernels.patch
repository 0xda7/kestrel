+        device const float4 * q4 = (device const float4 *) q_ptr + sub*(EPL/4);
+
+        float4 kv[EPL/4];
+        float4 qv[EPL/4];
+        FOR_UNROLL (short j = 0; j < EPL/4; j++) {
+            kv[j] = k4[j];
+            qv[j] = q4[j];
+        }
+
+        float k_n = 1.0f;
+        float q_n = 1.0f;
+        if (FC_gated_delta_net_l2k) {
+            float kk = 0.0f;
+            FOR_UNROLL (short j = 0; j < EPL/4; j++) {
