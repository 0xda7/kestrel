+    kernel_mul_mv_iq3_s_f32_nc_impl<NR0, 2>(args, src0, src1, dst, shmem, tgpig, tiisg, sgitg); \
+}
+
+IQ3_S_MV_NC(2)
+IQ3_S_MV_NC(4)
+IQ3_S_MV_NC(8)
