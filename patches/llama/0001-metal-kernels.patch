+        FOR_UNROLL (short row = 0; row < NR0; row++) {
+            device const block_q_type * qb = ax[row] + ib;
+
+            sumf[row] += block_q_n_dot_y(qb, sumy[0], yl,      0)
+                       + block_q_n_dot_y(qb, sumy[1], yl + 16, 8);
+        }
+
+        yb += QK4_0 * NQ;
+        //yb += NSG*NQ*QK4_0;
