+    if (args.with_norm != 0) {
+        float lsum = 0.0f;
+        for (int i = tiitg; i < nu; i += ntg) {
+            lsum += weights[i];
+        }
+        rv[tiitg] = lsum;
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+        for (uint s = ntg/2; s > 0; s >>= 1) {
+            if (tiitg < s) {
+                rv[tiitg] += rv[tiitg + s];
+            }
+            threadgroup_barrier(mem_flags::mem_threadgroup);
+        }
+        const float inv = 1.0f/max(rv[0], args.clamp);
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+        for (int i = tiitg; i < nu; i += ntg) {
